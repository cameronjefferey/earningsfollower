# Financial Modeling Prep API key. Get a free key at https://site.financialmodelingprep.com/
# Free tier (250 calls/day) is enough to start; Starter (~$22/mo) unlocks higher limits.
FMP_API_KEY=

# Database URL. Defaults to a local SQLite file. Swap for Postgres when deploying.
DATABASE_URL=sqlite:///./earningsfollower.db

# How many years of historical earnings/prices to pull per ticker.
HISTORY_YEARS=5

# CORS origins for the frontend (comma-separated).
CORS_ORIGINS=http://localhost:3000

# Set to "false" to disable the background daily refresh scheduler.
ENABLE_SCHEDULER=true

# --- Auth + Stripe paywall (optional; free to set up) -------------------------
# Leave PAYWALL_ENABLED=false until Google + Stripe are configured. Calendar
# stays public; Waves/Drift/Reddit/Paper/Learning/company require a subscription
# when the paywall is on.
PAYWALL_ENABLED=false
# Must match the frontend AUTH_SECRET (openssl rand -base64 32).
AUTH_SECRET=
# VIP emails (comma-separated): full Pro without Stripe. Not admin.
AUTH_BYPASS_EMAILS=
# Admin-only surfaces: Paper, Learning, company playbooks, Drift trade plans.
# Empty = nobody is admin (those routes return 403).
ADMIN_EMAILS=
# Stripe test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Dashboard webhook signing secret (whsec_...). Comma-separate if rotating.
STRIPE_WEBHOOK_SECRET=
# Create a Product + monthly Price in Stripe, then paste the price id (price_...).
# Must be from the same Stripe account/mode as STRIPE_SECRET_KEY.
STRIPE_PRICE_ID=
# EVERY price id this app sells (monthly, annual, legacy, promo), comma-separated.
# The live Stripe account is shared with other products and Stripe delivers the
# whole account's event stream to every webhook endpoint, so the webhook only
# acts on objects carrying one of these ids. Missing an id here means those
# subscribers silently lose access; leaving it empty means we own nothing.
STRIPE_PRICE_IDS=
# Frontend origin for Checkout success/cancel fallbacks (also used in magic /
# verify / reset email links).
PUBLIC_APP_URL=http://localhost:3000

# Resend (https://resend.com) — magic-link login, verify email, password reset.
# Verify your sending domain in Resend, then set a From address on that domain.
RESEND_API_KEY=
RESEND_FROM=Earnings Follower <login@earningsfollower.com>
# Where /contact form messages are delivered (Reply-To = visitor email).
CONTACT_INBOX=happyuphilltrader@gmail.com

# --- Alpaca paper trading (the autonomous earnings trader) -------------------
# Generate a PAPER key pair at https://app.alpaca.markets/paper/dashboard/overview
# Paper accounts automatically have Level 3 (multi-leg) options enabled.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Keep true to trade the paper account. Set false only for a funded live account.
ALPACA_PAPER=true
# Live underlying price feed. "iex" is free/real-time (IEX-only volume); "sip" is
# the full consolidated tape but needs Alpaca's paid market-data subscription.
# Falls back to iex automatically if the chosen feed isn't entitled.
ALPACA_DATA_FEED=iex
# Enter an earnings setup when the report is within this many days.
PAPER_ENTRY_WINDOW_DAYS=7
# Conviction-weighted max-loss budget per trade, as a fraction of equity.
PAPER_RISK_HIGH=0.05
PAPER_RISK_MEDIUM=0.03
PAPER_RISK_LOW=0.015
# Proactive loss-cutting on sell-vol / earnings credit trades (fraction of max
# risk). Keep on — otherwise take-profits clip winners while losers run.
PAPER_STOPS_ENABLED=true
PAPER_STOP_LOSS_FRAC=0.20
PAPER_LATE_DTE=1
PAPER_LATE_STOP_FRAC=0.10

# Calibration: nudge the +EV gate with realized-vs-predicted win rates.
PAPER_CALIBRATION_ENABLED=true

# Entry model: jointly weight market cap, dollar volume, implied move, and
# history on graded trades. Vetoes names it scores below MIN_PROB; otherwise
# its P(win) feeds the +EV gate. Falls back to the heuristic when the journal
# is too thin or out-of-sample AUC is a coin flip.
PAPER_ENTRY_MODEL_ENABLED=true
PAPER_ENTRY_MODEL_MIN_PROB=0.45

# Waves / drift option debit books are retired (post-print IV crush). Open
# positions still manage; these flags only block new entries.
PAPER_WAVES_ENABLED=false
PAPER_WAVE_GAIN_PCT=0.10
PAPER_WAVE_LOSS_PCT=0.05
PAPER_DRIFT_ENABLED=false
PAPER_DRIFT_RISK_FRAC=0.015
PAPER_DRIFT_MAX_OPEN=8
PAPER_DRIFT_HOLD_DAYS=7
PAPER_DRIFT_TAKE_PROFIT=0.75
# Broken-thesis stop only fires this fraction beyond the earnings-day pivot, so
# noise around the level doesn't whipsaw a fresh entry into a loss.
PAPER_DRIFT_STOP_BUFFER=0.015

# 5-day loser weekly (S&P 500, long shares). Rank the worst 5-session names,
# hold 5 sessions or take-profit at +10%, skip earnings ±5 sessions.
PAPER_REVERSAL_ENABLED=true
PAPER_REVERSAL_TOP_N=5
PAPER_REVERSAL_LOOKBACK_DAYS=5
PAPER_REVERSAL_HOLD_DAYS=5
PAPER_REVERSAL_TAKE_PROFIT_PCT=0.10
PAPER_REVERSAL_MIN_PRICE=10
PAPER_REVERSAL_MIN_DOLLAR_VOL=50000000
PAPER_REVERSAL_EARN_BUFFER_DAYS=5
PAPER_REVERSAL_RISK_FRAC=0.02
PAPER_REVERSAL_MAX_OPEN=5

# Fills: entries price at the marketable cross (take the ask / hit the bid, plus
# PAPER_FILL_BUFFER) so wide/illiquid spreads fill. Exits price at the mid only
# nudged by the buffer — we never cross to a dead bid and dump a held spread for
# a penny. Orders go out only while the market is open; only filled orders
# become tracked positions.
PAPER_MARKET_HOURS_ONLY=true
PAPER_FILL_CROSS=true
PAPER_FILL_BUFFER=0.03

# --- Telegram (optional) -----------------------------------------------------
# Same bot/chat for paper fill alerts and new Waves/Drift setup pings.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_TRADES=true
TELEGRAM_NOTIFY_SETUPS=true
TELEGRAM_NOTIFY_SIGNUP=true
