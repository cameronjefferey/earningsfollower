# Financial Modeling Prep API key. Get a free key at https://site.financialmodelingprep.com/
# Free tier (250 calls/day) is enough to start; Starter (~$22/mo) unlocks higher limits.
FMP_API_KEY=

# Database URL. Defaults to a local SQLite file. Swap for Postgres when deploying.
DATABASE_URL=sqlite:///./earningsfollower.db

# How many years of historical earnings/prices to pull per ticker.
HISTORY_YEARS=5

# CORS origins for the frontend (comma-separated).
CORS_ORIGINS=http://localhost:3000

# Set to "false" to disable the background daily refresh scheduler.
ENABLE_SCHEDULER=true

# --- Alpaca paper trading (the autonomous earnings trader) -------------------
# Generate a PAPER key pair at https://app.alpaca.markets/paper/dashboard/overview
# Paper accounts automatically have Level 3 (multi-leg) options enabled.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Keep true to trade the paper account. Set false only for a funded live account.
ALPACA_PAPER=true
# Conviction-weighted max-loss budget per trade, as a fraction of equity.
PAPER_RISK_HIGH=0.05
PAPER_RISK_MEDIUM=0.03
PAPER_RISK_LOW=0.015
# Proactive loss-cutting on sell-vol trades. Off to start (exit only after the
# print); flip to true to arm the stops. Fractions of a trade's max risk.
PAPER_STOPS_ENABLED=false
PAPER_STOP_LOSS_FRAC=0.20
PAPER_LATE_DTE=1
PAPER_LATE_STOP_FRAC=0.10

# Waves: directional sympathy-drift trades (long calls/puts). Bracket measured
# on the underlying's move from entry; exits the day before the target's print.
PAPER_WAVES_ENABLED=true
PAPER_WAVE_GAIN_PCT=0.10
PAPER_WAVE_LOSS_PCT=0.05
