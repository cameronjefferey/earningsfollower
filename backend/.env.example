# Financial Modeling Prep API key. Get a free key at https://site.financialmodelingprep.com/
# Free tier (250 calls/day) is enough to start; Starter (~$22/mo) unlocks higher limits.
FMP_API_KEY=

# Database URL. Defaults to a local SQLite file. Swap for Postgres when deploying.
DATABASE_URL=sqlite:///./earningsfollower.db

# How many years of historical earnings/prices to pull per ticker.
HISTORY_YEARS=5

# CORS origins for the frontend (comma-separated).
CORS_ORIGINS=http://localhost:3000

# Set to "false" to disable the background daily refresh scheduler.
ENABLE_SCHEDULER=true

# --- Alpaca paper trading (the autonomous earnings trader) -------------------
# Generate a PAPER key pair at https://app.alpaca.markets/paper/dashboard/overview
# Paper accounts automatically have Level 3 (multi-leg) options enabled.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Keep true to trade the paper account. Set false only for a funded live account.
ALPACA_PAPER=true
# Live underlying price feed. "iex" is free/real-time (IEX-only volume); "sip" is
# the full consolidated tape but needs Alpaca's paid market-data subscription.
# Falls back to iex automatically if the chosen feed isn't entitled.
ALPACA_DATA_FEED=iex
# Enter an earnings setup when the report is within this many days.
PAPER_ENTRY_WINDOW_DAYS=7
# Conviction-weighted max-loss budget per trade, as a fraction of equity.
PAPER_RISK_HIGH=0.05
PAPER_RISK_MEDIUM=0.03
PAPER_RISK_LOW=0.015
# Proactive loss-cutting on sell-vol trades. Off to start (exit only after the
# print); flip to true to arm the stops. Fractions of a trade's max risk.
PAPER_STOPS_ENABLED=false
PAPER_STOP_LOSS_FRAC=0.20
PAPER_LATE_DTE=1
PAPER_LATE_STOP_FRAC=0.10

# Waves: directional sympathy-drift trades (long calls/puts). Bracket measured
# on the underlying's move from entry; exits the day before the target's print.
PAPER_WAVES_ENABLED=true
PAPER_WAVE_GAIN_PCT=0.10
PAPER_WAVE_LOSS_PCT=0.05

# Drift (PEAD): post-earnings announcement drift, expressed as a directional
# debit spread. Exits on a time horizon (hold days), a take-profit (% of the
# spread width), or a broken-thesis stop (underlying gives back the move).
PAPER_DRIFT_ENABLED=true
PAPER_DRIFT_RISK_FRAC=0.015
PAPER_DRIFT_MAX_OPEN=8
PAPER_DRIFT_HOLD_DAYS=7
PAPER_DRIFT_TAKE_PROFIT=0.75
# Broken-thesis stop only fires this fraction beyond the earnings-day pivot, so
# noise around the level doesn't whipsaw a fresh entry into a loss.
PAPER_DRIFT_STOP_BUFFER=0.015

# Fills: entries price at the marketable cross (take the ask / hit the bid, plus
# PAPER_FILL_BUFFER) so wide/illiquid spreads fill. Exits price at the mid only
# nudged by the buffer — we never cross to a dead bid and dump a held spread for
# a penny. Orders go out only while the market is open; only filled orders
# become tracked positions.
PAPER_MARKET_HOURS_ONLY=true
PAPER_FILL_CROSS=true
PAPER_FILL_BUFFER=0.03
