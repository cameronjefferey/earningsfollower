# Base URL of the FastAPI backend.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# --- Auth.js (Google) + paywall ----------------------------------------------
# Generate with: openssl rand -base64 32
# Must match backend AUTH_SECRET.
AUTH_SECRET=

# Free Google OAuth client: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Flip to "true" only after backend PAYWALL_ENABLED=true and Stripe is wired.
NEXT_PUBLIC_PAYWALL_ENABLED=false

# Optional: public site URL for Auth.js in production (Render sets HOSTNAME;
# trustHost is enabled in auth.ts so this is usually unnecessary).
# AUTH_URL=http://localhost:3000
