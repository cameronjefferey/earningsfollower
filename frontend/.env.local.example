# Base URL of the FastAPI backend.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# --- Auth.js (Google + email/password + magic link) + paywall ----------------
# Generate with: openssl rand -base64 32
# Must match backend AUTH_SECRET.
AUTH_SECRET=

# Free Google OAuth client: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Absolute backend URL for Auth.js server callbacks (register/login sync).
# AUTH_API_BASE=http://127.0.0.1:8000

# Magic link / password reset / verify emails are sent by the backend via Resend
# (RESEND_API_KEY + RESEND_FROM on the API service).

# Flip to "true" only after backend PAYWALL_ENABLED=true and Stripe is wired.
NEXT_PUBLIC_PAYWALL_ENABLED=false

# Canonical site URL for Auth.js. Required in production (otherwise Render can
# emit redirect_uri=https://localhost:$PORT/...). Locally optional.
# AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
